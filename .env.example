# カラス（Crow）— ローカル環境テンプレート。
# `.env.local` にコピーして値を入れる。`.env.local` は絶対にコミットしない。

# Gemini Developer API のキー（サーバー側でのみ使用）。
# https://aistudio.google.com/apikey で取得。
GEMINI_API_KEY=your-gemini-api-key

# 使うモデル（未設定なら gemini-2.5-flash）。
# GEMINI_MODEL=gemini-2.5-flash

# 将来 Vertex AI に移すときは lib/gemini.ts の getClient() だけ差し替える。
# その場合に使う値（今は不要）：
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
